# Конфигурация weatherbot: cp .env.example .env, затем make run.
# Формат: KEY=value — без пробелов вокруг "=", без кавычек и без комментариев после значения
# (файл читается через `. ./.env`). Пустое значение = значение по умолчанию.

# Обязательна. Токен бота от @BotFather.
# Формат: <digits>:<secret>, secret — символы A-Z a-z 0-9 _ -
TELEGRAM_BOT_TOKEN=

# Обязательна. Ключ API OpenWeatherMap (новый ключ активируется до пары часов).
OPENWEATHER_API_KEY=

# Необязательна. Default: https://api.telegram.org
# Формат: http(s)://host[:port][/path], без query и fragment.
TELEGRAM_BASE_URL=

# Необязательна. Default: https://api.openweathermap.org
# Формат: http(s)://host[:port][/path], без query и fragment.
OPENWEATHER_BASE_URL=

# Необязательна. Default: info. Допустимо: debug, info, warn, error.
LOG_LEVEL=

# Необязательна. Default: json. Допустимо: json, text (без учёта регистра).
LOG_FORMAT=
