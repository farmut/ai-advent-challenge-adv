# Template for .env (valid shell: load with  set -a; . ./.env; set +a).
# Never commit .env (it is git-ignored). Create it with generated secrets
# (does not overwrite an existing .env):
#   [ -e .env ] && echo ".env exists, not overwritten" || (umask 077; sed \
#     -e "s/^PROXY_API_KEYS=$/PROXY_API_KEYS=$(openssl rand -hex 32),$(openssl rand -hex 32)/" \
#     -e "s/^AUDIT_PEPPER=$/AUDIT_PEPPER=$(openssl rand -hex 32)/" .env.example > .env)

# Client Bearer keys of the proxy (comma-separated, 32-256 chars each),
# e.g. two values of: openssl rand -hex 32. Empty = the proxy does not start.
PROXY_API_KEYS=

# HMAC pepper (>= 16 chars, e.g. openssl rand -hex 32) for key_id and
# fingerprints in the audit log. Empty = random pepper per start (ids are not
# stable across restarts); required for a non-loopback listen address.
AUDIT_PEPPER=

# Optional: enables the gpt-4.1-mini cloud route. Empty = that route answers 503.
OPENAI_API_KEY=

# Optional overrides (see configs/proxy.yaml):
# PROXY_GUARD_MODE=block
# PROXY_MODEL_QWEN2_5_7B_OLLAMA_UPSTREAM_MODEL=qwen2.5:7b-instruct
# PROXY_MODEL_QWEN2_5_7B_LMSTUDIO_UPSTREAM_MODEL=qwen2.5-7b-instruct
