{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "Edit(./internal/**)",
      "Edit(./cmd/**)",
      "Bash(go test:*)",
      "Bash(go build ./...)",
      "Bash(go build ./...:*)",
      "Bash(go vet:*)",
      "Bash(gofmt -l:*)",
      "Bash(gofmt -d:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/.netrc)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.git/**)",
      "Edit(./.claude/**)",
      "Edit(./.mcp.json)",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git -c *)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(cat:*)",
      "Bash(make:*)",
      "Bash(go run:*)",
      "Bash(go generate:*)",
      "Bash(go get:*)",
      "Bash(go install:*)",
      "Bash(go mod:*)",
      "Bash(go env -w:*)",
      "Bash(go * -exec*)",
      "Bash(go * -toolexec*)",
      "Bash(go vet -vettool*)",
      "Edit(./go.mod)",
      "Edit(./go.sum)",
      "Edit(./Makefile)",
      "Edit(./README.md)",
      "Edit(./docs/**)",
      "Edit(./.gitignore)",
      "Edit(./.env.example)",
      "Bash(gofmt -w:*)",
      "Bash(go build -o:*)",
      "Bash(go build * -o *)",
      "Bash(go build ./cmd/*)"
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "disableAllHooks": true,
  "enableAllProjectMcpServers": false,
  "env": {
    "GOTOOLCHAIN": "local",
    "GOPROXY": "off",
    "GOFLAGS": "-mod=readonly"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": true
    }
  },
  "autoMemoryEnabled": false
}
