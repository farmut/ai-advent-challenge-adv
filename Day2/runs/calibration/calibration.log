 }
+
+func (h *Handler) shouldWarn(chatID int64, now time.Time) bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if last, ok := h.warned[chatID]; ok && now.Sub(last) < perChatInterval {
+		return false
+	}
+	if len(h.warned) >= maxTrackedChats {
+		clear(h.warned)
+	}
+	h.warned[chatID] = now
+	return true
