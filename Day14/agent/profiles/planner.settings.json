{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/.netrc)",
      "Edit(./**)",
      "Write(./**)",
      "Bash"
    ]
  },
  "env": {
    "GOTOOLCHAIN": "local",
    "GOPROXY": "off",
    "GOFLAGS": "-mod=readonly"
  }
}
