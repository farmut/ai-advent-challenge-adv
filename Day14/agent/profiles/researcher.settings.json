{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/.netrc)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.git/**)",
      "Edit(./.claude/**)",
      "Edit(./.mcp.json)",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git -c *)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(cat:*)",
      "Bash(make:*)",
      "Bash(go run:*)",
      "Bash(go generate:*)",
      "Bash(go get:*)",
      "Bash(go install:*)",
      "Bash(go mod:*)",
      "Bash(go env -w:*)",
      "Bash(go * -exec*)",
      "Bash(go * -toolexec*)",
      "Bash(go vet -vettool*)",
      "Edit(./**)",
      "Write(./**)",
      "Bash"
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "disableAllHooks": true,
  "enableAllProjectMcpServers": false,
  "env": {
    "GOTOOLCHAIN": "local",
    "GOPROXY": "off",
    "GOFLAGS": "-mod=readonly"
  },
  "autoMemoryEnabled": false
}
