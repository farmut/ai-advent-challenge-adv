+package config
+
+import (
+	"log/slog"
+	"strings"
+	"testing"
+)
+
+func setEnv(t *testing.T, kv map[string]string) {
+	t.Helper()
+	for k, v := range kv {
+		t.Setenv(k, v)
+	}
+}
+
+func TestLoadDefaults(t *testing.T) {
+	setEnv(t, map[string]string{
+		"TELEGRAM_BOT_TOKEN":  "tg-token",
+		"OPENWEATHER_API_KEY": "owm-key",
+	})
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load() err = %v", err)
+	}
+	if cfg.TelegramBaseURL != "https://api.telegram.org" {
+		t.Errorf("TelegramBaseURL = %q", cfg.TelegramBaseURL)
+	}
+	if cfg.OpenWeatherBaseURL != "https://api.openweathermap.org" {
+		t.Errorf("OpenWeatherBaseURL = %q", cfg.OpenWeatherBaseURL)
+	}
+	if cfg.LogLevel != slog.LevelInfo {
+		t.Errorf("LogLevel = %v", cfg.LogLevel)
+	}
+}
+
+func TestLoadMissingRequired(t *testing.T) {
+	setEnv(t, map[string]string{
+		"TELEGRAM_BOT_TOKEN":  "",
+		"OPENWEATHER_API_KEY": "",
+	})
+	_, err := Load()
+	if err == nil {
+		t.Fatal("Load() err = nil, want error")
+	}
+	msg := err.Error()
+	if !strings.Contains(msg, "TELEGRAM_BOT_TOKEN") || !strings.Contains(msg, "OPENWEATHER_API_KEY") {
+		t.Errorf("err = %q, want both missing vars", msg)
+	}
+}
+
+func TestLoadCustomValues(t *testing.T) {
+	setEnv(t, map[string]string{
+		"TELEGRAM_BOT_TOKEN":   "tg-token",
+		"OPENWEATHER_API_KEY":  "owm-key",
+		"TELEGRAM_BASE_URL":    "http://127.0.0.1:8080",
+		"OPENWEATHER_BASE_URL": "http://127.0.0.1:8081",
+		"LOG_LEVEL":            "debug",
+	})
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load() err = %v", err)
+	}
+	if cfg.TelegramBaseURL != "http://127.0.0.1:8080" {
+		t.Errorf("TelegramBaseURL = %q", cfg.TelegramBaseURL)
+	}
+	if cfg.OpenWeatherBaseURL != "http://127.0.0.1:8081" {
+		t.Errorf("OpenWeatherBaseURL = %q", cfg.OpenWeatherBaseURL)
+	}
+	if cfg.LogLevel != slog.LevelDebug {
+		t.Errorf("LogLevel = %v", cfg.LogLevel)
+	}
+}
+
+func TestLoadInvalidLogLevel(t *testing.T) {
+	setEnv(t, map[string]string{
+		"TELEGRAM_BOT_TOKEN":  "tg-token",
+		"OPENWEATHER_API_KEY": "owm-key",
+		"LOG_LEVEL":           "verbose",
+	})
+	_, err := Load()
+	if err == nil {
+		t.Fatal("Load() err = nil, want error for invalid LOG_LEVEL")
+	}
+}
diff --git a/internal/delivery/telegram/client.go b/internal/delivery/telegram/client.go
new file mode 100644
index 0000000..4651840
--- /dev/null
+++ b/internal/delivery/telegram/client.go
@@ -0,0 +1,123 @@
+package telegram
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+const maxBodyBytes = 1 << 20 // 1 MiB
+
+// Update — входящее обновление Telegram.
+type Update struct {
+	UpdateID int64    `json:"update_id"`
+	Message  *Message `json:"message"`
+}
+
+// Message — сообщение из чата.
+type Message struct {
+	Chat Chat   `json:"chat"`
+	Text string `json:"text"`
+}
+
+// Chat — чат, из которого пришло сообщение.
+type Chat struct {
+	ID int64 `json:"id"`
+}
+
+// Client — HTTP-клиент Telegram Bot API.
+type Client struct {
+	baseURL    string
+	token      string
+	httpClient *http.Client
+}
+
+// NewClient создаёт клиент Bot API. httpClient обязан иметь Timeout больше long-poll timeout.
+func NewClient(baseURL, token string, httpClient *http.Client) *Client {
+	return &Client{baseURL: baseURL, token: token, httpClient: httpClient}
+}
+
+// GetUpdates возвращает новые обновления начиная с offset.
+func (c *Client) GetUpdates(ctx context.Context, offset int64) ([]Update, error) {
+	u, err := url.Parse(c.baseURL)
+	if err != nil {
+		return nil, fmt.Errorf("parse base url: %w", err)
+	}
+	u = u.JoinPath("bot"+c.token, "getUpdates")
+	q := url.Values{}
+	q.Set("offset", fmt.Sprintf("%d", offset))
+	q.Set("timeout", "30")
+	q.Set("allowed_updates", `["message"]`)
+	u.RawQuery = q.Encode()
+
+	var updates []Update
+	if err := c.doJSON(ctx, u.String(), &updates); err != nil {
+		return nil, err
+	}
+	return updates, nil
+}
+
+// Send отправляет текст в чат (plain text, без parse_mode).
+func (c *Client) Send(ctx context.Context, chatID int64, text string) error {
+	u, err := url.Parse(c.baseURL)
+	if err != nil {
+		return fmt.Errorf("parse base url: %w", err)
+	}
+	u = u.JoinPath("bot"+c.token, "sendMessage")
+	q := url.Values{}
+	q.Set("chat_id", fmt.Sprintf("%d", chatID))
+	q.Set("text", text)
+	u.RawQuery = q.Encode()
+
+	return c.doJSON(ctx, u.String(), nil)
+}
+
+func (c *Client) doJSON(ctx context.Context, rawURL string, out any) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil)
+	if err != nil {
+		return c.redact(fmt.Errorf("build request: %w", err))
+	}
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return c.redact(fmt.Errorf("telegram request: %w", err))
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxBodyBytes))
+	if err != nil {
+		return c.redact(fmt.Errorf("read telegram response: %w", err))
+	}
+	if resp.StatusCode == http.StatusTooManyRequests {
+		return c.redact(&rateLimitError{body: body})
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return c.redact(fmt.Errorf("telegram status %d: %s", resp.StatusCode, truncate(string(body), 256)))
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(body, out); err != nil {
+		return c.redact(fmt.Errorf("decode telegram response: %w", err))
+	}
+	return nil
+}
+
+// redact убирает токен из ошибки: *url.Error содержит полный URL с токеном в пути.
+func (c *Client) redact(err error) error {
+	if err == nil {
+		return nil
+	}
+	return fmt.Errorf("%s", strings.ReplaceAll(err.Error(), c.token, "[REDACTED]"))
+}
+
+func truncate(s string, n int) string {
+	r := []rune(s)
+	if len(r) <= n {
+		return s
+	}
+	return string(r[:n]) + "..."
+}
