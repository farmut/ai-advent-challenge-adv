+}
diff --git a/internal/delivery/telegram/poller.go b/internal/delivery/telegram/poller.go
new file mode 100644
index 0000000..95d9795
--- /dev/null
+++ b/internal/delivery/telegram/poller.go
@@ -0,0 +1,125 @@
+package telegram
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"time"
+)
+
+const (
+	backoffBase = time.Second
+	backoffMax  = 30 * time.Second
+)
+
+// Updater — источник обновлений Telegram.
+type Updater interface {
+	GetUpdates(ctx context.Context, offset int64) ([]Update, error)
+}
+
+// MessageHandler обрабатывает одно сообщение.
+type MessageHandler interface {
+	Handle(ctx context.Context, chatID int64, text string)
+}
+
+// Poller — цикл long polling.
+type Poller struct {
+	updates Updater
+	handler MessageHandler
+	log     *slog.Logger
+}
+
+// NewPoller создаёт poller.
+func NewPoller(updates Updater, handler MessageHandler, log *slog.Logger) *Poller {
+	return &Poller{updates: updates, handler: handler, log: log}
+}
+
+// Run опрашивает getUpdates, пока ctx не отменён. Возвращает ошибку только при сбое,
+// не связанном с отменой контекста.
+func (p *Poller) Run(ctx context.Context) error {
+	var offset int64
+	backoff := backoffBase
+	for {
+		updates, err := p.updates.GetUpdates(ctx, offset)
+		if err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			if d, ok := retryAfterFromError(err); ok {
+				p.log.Warn("telegram rate limited, waiting retry_after", "retry_after", d)
+				if err := sleepCtx(ctx, d); err != nil {
+					return err
+				}
+				backoff = backoffBase
+				continue
+			}
+			p.log.Warn("getUpdates failed, backing off", "err", err, "backoff", backoff)
+			if err := sleepCtx(ctx, backoff); err != nil {
+				return err
+			}
+			backoff = min(backoff*2, backoffMax)
+			continue
+		}
+		backoff = backoffBase
+		for _, u := range updates {
+			if u.UpdateID >= offset {
+				offset = u.UpdateID + 1
+			}
+			if u.Message != nil {
+				p.handler.Handle(ctx, u.Message.Chat.ID, u.Message.Text)
+			}
+		}
+	}
+}
+
+// rateLimitError — ошибка 429 с телом ответа, чтобы извлечь retry_after.
+type rateLimitError struct {
+	body []byte
+}
+
+func (e *rateLimitError) Error() string {
+	return fmt.Sprintf("telegram rate limited: status 429, body: %s", truncate(string(e.body), 256))
+}
+
+// retryAfterFromError извлекает parameters.retry_after из ошибки 429.
+func retryAfterFromError(err error) (time.Duration, bool) {
+	var rle *rateLimitError
+	if !asError(err, &rle) {
+		return 0, false
+	}
+	var resp struct {
+		Parameters struct {
+			RetryAfter int `json:"retry_after"`
+		} `json:"parameters"`
+	}
+	if json.Unmarshal(rle.body, &resp) != nil || resp.Parameters.RetryAfter <= 0 {
+		return backoffBase, true
+	}
+	return time.Duration(resp.Parameters.RetryAfter) * time.Second, true
+}
+
+func asError(err error, target **rateLimitError) bool {
+	for err != nil {
+		if rle, ok := err.(*rateLimitError); ok {
+			*target = rle
+			return true
+		}
+		type unwrapper interface{ Unwrap() error }
+		u, ok := err.(unwrapper)
+		if !ok {
+			return false
+		}
+		err = u.Unwrap()
+	}
+	return false
+}
+
+func sleepCtx(ctx context.Context, d time.Duration) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-time.After(d):
+		return nil
+	}
+}
diff --git a/internal/delivery/telegram/poller_test.go b/internal/delivery/telegram/poller_test.go
new file mode 100644
index 0000000..fbdb175
--- /dev/null
+++ b/internal/delivery/telegram/poller_test.go
@@ -0,0 +1,125 @@
+package telegram
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"os"
+	"testing"
+	"time"
+)
+
+type fakeUpdater struct {
+	calls   int
+	offsets []int64
+	updates []Update
+	err     error
+}
+
+func (f *fakeUpdater) GetUpdates(_ context.Context, offset int64) ([]Update, error) {
+	f.calls++
+	f.offsets = append(f.offsets, offset)
+	return f.updates, f.err
+}
+
+type recordingHandler struct {
+	messages []string
+}
+
+func (r *recordingHandler) Handle(_ context.Context, _ int64, text string) {
+	r.messages = append(r.messages, text)
+}
+
+func quietLogger() *slog.Logger {
+	return slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelError}))
+}
+
+func TestPollerProcessesUpdatesAndAdvancesOffset(t *testing.T) {
+	fu := &fakeUpdater{updates: []Update{
+		{UpdateID: 1, Message: &Message{Chat: Chat{ID: 10}, Text: "a"}},
+		{UpdateID: 2, Message: &Message{Chat: Chat{ID: 10}, Text: "b"}},
+		{UpdateID: 3}, // без сообщения
+	}}
+	rh := &recordingHandler{}
+	p := NewPoller(fu, rh, quietLogger())
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- p.Run(ctx) }()
+
+	deadline := time.After(2 * time.Second)
+	for len(rh.messages) < 2 {
+		select {
+		case <-deadline:
+			t.Fatal("poller did not process updates in time")
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("Run() err = %v, want context.Canceled", err)
+	}
+	if fu.offsets[0] != 0 || fu.offsets[1] != 4 {
+		t.Errorf("offsets = %v, want [0 4]", fu.offsets)
+	}
+	if len(rh.messages) != 2 || rh.messages[0] != "a" || rh.messages[1] != "b" {
+		t.Errorf("messages = %v", rh.messages)
+	}
+}
+
+func TestPollerBackoffOnErrors(t *testing.T) {
+	fu := &fakeUpdater{err: errors.New("network down")}
+	rh := &recordingHandler{}
+	p := NewPoller(fu, rh, quietLogger())
+
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := p.Run(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Run() err = %v, want DeadlineExceeded", err)
+	}
+	if fu.calls < 2 {
+		t.Errorf("GetUpdates calls = %d, want >= 2 (backoff retries)", fu.calls)
+	}
+}
+
+func TestPollerRateLimitWaitsRetryAfter(t *testing.T) {
+	fu := &fakeUpdater{err: &rateLimitError{body: []byte(`{"ok":false,"parameters":{"retry_after":1}}`)}}
+	rh := &recordingHandler{}
+	p := NewPoller(fu, rh, quietLogger())
+
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	start := time.Now()
+	if err := p.Run(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Run() err = %v, want DeadlineExceeded", err)
+	}
+	// 3 секунды: первый вызов + retry_after 1с + повтор + retry_after 1с + повтор ≈ 3 вызова.
+	if fu.calls < 2 {
+		t.Errorf("GetUpdates calls = %d, want >= 2", fu.calls)
+	}
+	if time.Since(start) < 2*time.Second {
+		t.Errorf("poller retried too fast, retry_after not honored")
+	}
+}
+
+func TestRetryAfterFromError(t *testing.T) {
+	tests := []struct {
+		name   string
+		err    error
+		want   time.Duration
+		wantOK bool
+	}{
+		{name: "with retry_after", err: &rateLimitError{body: []byte(`{"parameters":{"retry_after":5}}`)}, want: 5 * time.Second, wantOK: true},
+		{name: "without parameters", err: &rateLimitError{body: []byte(`{"ok":false}`)}, want: backoffBase, wantOK: true},
+		{name: "broken body", err: &rateLimitError{body: []byte(`not json`)}, want: backoffBase, wantOK: true},
+		{name: "other error", err: errors.New("boom"), wantOK: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, ok := retryAfterFromError(tt.err)
+			if ok != tt.wantOK || got != tt.want {
+				t.Errorf("retryAfterFromError() = (%v, %v), want (%v, %v)", got, ok, tt.want, tt.wantOK)
+			}
+		})
+	}
+}
