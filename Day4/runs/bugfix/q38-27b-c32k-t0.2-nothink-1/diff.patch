+// TestHandlerRateLimitBurst — всплеск из 10 сообщений подряд: не больше одного
+// исходящего sendMessage за окно ограничения, остальные молча игнорируются.
+func TestHandlerRateLimitBurst(t *testing.T) {
+	w := &fakeWeather{w: domain.Weather{City: "Москва"}}
+	h, s := newTestHandler(w)
+
+	h.Handle(t.Context(), 1, "Москва")
+	for i := 0; i < 10; i++ {
+		h.Handle(t.Context(), 1, "Москва")
+	}
+
+	if len(s.sent) != 1 {
+		t.Fatalf("send attempts = %d (%v), want 1", len(s.sent), s.sent)
+	}
+	if s.sent[0] != formatWeather(w.w) {
+		t.Errorf("sent = %q, want weather reply", s.sent[0])
+	}
+	if strings.Contains(strings.Join(s.sent, "|"), msgTooFrequent) {
+		t.Errorf("burst produced %q replies, want none: %v", msgTooFrequent, s.sent)
+	}
+	if w.gotCity != "Москва" {
+		t.Errorf("weather called with city %q, want %q", w.gotCity, "Москва")
+	}
+}
