+func TestHandlerSpam(t *testing.T) {
+	w := &fakeWeather{w: domain.Weather{City: "Москва"}}
+	h, s := newTestHandler(w)
+
+	// Отправляем спам в один чат
+	for i := 0; i < 10; i++ {
+		h.Handle(t.Context(), 1, "/start")
+	}
+
+	// Проверяем, что только первое сообщение было обработано
+	// Остальные должны быть проигнорированы, но не отправлены как ответы
+	if len(s.sent) != 1 {
+		t.Errorf("sent = %q, want only first message", s.sent)
+	}
+	if s.sent[0] != msgStart {
+		t.Errorf("first sent = %q, want %q", s.sent[0], msgStart)
